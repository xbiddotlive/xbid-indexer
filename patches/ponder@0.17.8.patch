diff --git a/src/runtime/arc-ranges.ts b/src/runtime/arc-ranges.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bd9d8dd7a9776f9e6ce189462b90043dec1cd109
--- /dev/null
+++ b/src/runtime/arc-ranges.ts
@@ -0,0 +1,34 @@
+import { hexToNumber, numberToHex } from "viem";
+import type { Common } from "../internal/common.js";
+import type { Chain, LightBlock } from "../internal/types.js";
+import type { Rpc } from "../rpc/index.js";
+import { eth_getBlockByNumber } from "../rpc/actions.js";
+import { ShutdownError } from "../internal/errors.js";
+
+export const isArcRangeMode = (chain: Pick<Chain, "id">) =>
+  chain.id === 5042 && process.env.PONDER_ARC_RANGE_MODE === "true";
+
+/** Poll range boundaries, never each intervening block. Only confirmed ranges
+ * are passed to the existing historical log/projector transaction pipeline. */
+export async function waitForNextArcRange({ common, chain, rpc, previous, sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)) }: {
+  common: Pick<Common, "shutdown" | "logger">;
+  chain: Pick<Chain, "pollingInterval" | "finalityBlockCount">;
+  rpc: Rpc;
+  previous: LightBlock;
+  sleep?: (ms: number) => Promise<void>;
+}): Promise<LightBlock> {
+  while (!common.shutdown.isKilled) {
+    await sleep(Math.max(chain.pollingInterval, 5_000));
+    if (common.shutdown.isKilled) throw new ShutdownError();
+    const context = { logger: common.logger.child({ action: "poll_xbid_range" }) };
+    const latest = await eth_getBlockByNumber(rpc, ["latest", false], context);
+    const target = hexToNumber(latest.number) - chain.finalityBlockCount;
+    if (target <= hexToNumber(previous.number)) continue;
+    // A changed confirmed boundary is an integrity error, not permission to
+    // advance the cursor or silently serve a fabricated empty range.
+    const anchor = await eth_getBlockByNumber(rpc, [previous.number, false], context);
+    if (anchor.hash !== previous.hash) throw new Error("Arc confirmed range boundary changed; indexing halted for recovery.");
+    return eth_getBlockByNumber(rpc, [numberToHex(target), false], context);
+  }
+  throw new ShutdownError();
+}
